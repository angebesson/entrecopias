# Copiar a .env.local para probar, y cargar las mismas variables en Vercel > Settings > Environment Variables.
# NUNCA subir claves reales a GitHub.

# Supabase (Project Settings > API). La service key es SECRETA: solo vive en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Mercado Pago (Tus integraciones > Credenciales de PRUEBA). El access token de prueba empieza con TEST-
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones > Webhooks > Clave secreta)
MP_WEBHOOK_SECRET=

# URL publica del sitio, sin barra final (ej: https://copia-litoral.vercel.app)
SITE_URL=
